# gofile Environment Configuration
# Copy this file to .env and adjust values as needed

# Server
SERVER_ADDR=:8080

# MySQL (required)
MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/gofile?charset=utf8mb4&parseTime=True&loc=Local

# MinIO (optional - leave MINIO_ENDPOINT empty to use local storage)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=filestore
MINIO_USE_SSL=false

# Local storage paths
UPLOAD_DIR=./uploads
CHUNK_DIR=./chunks

# Redis (optional)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# AI features (optional, disabled by default)
# Set AI_ENABLED=true to enable semantic search, file summarization, and auto-tagging
AI_ENABLED=false
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_EMBED_DIM=128
AI_WORKERS=4
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=xyz

# 用户级 AI Provider 配置(前端 AI 设置)
# 用户在网页「AI 设置」中自定义 OpenAI 协议 baseURL + API key,保存后按用户生效
# AI_CONFIG_SECRET:API key 加密密钥(建议设置随机值;未设置时从 MYSQL_DSN 派生)
AI_CONFIG_SECRET=
# ALLOW_PRIVATE_AI_URL:允许自定义 baseURL 指向内网/本机(如本地 Ollama),默认 false 防 SSRF
ALLOW_PRIVATE_AI_URL=false
