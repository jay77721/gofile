# FileStore Server Environment Configuration
# Copy this file to .env and adjust values as needed

# Server
SERVER_ADDR=:8080

# MySQL (required)
MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/fileserver?charset=utf8mb4&parseTime=True&loc=Local

# MinIO (optional - leave MINIO_ENDPOINT empty to use local storage)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=filestore
MINIO_USE_SSL=false

# Local storage paths
UPLOAD_DIR=./uploads
CHUNK_DIR=./chunks
