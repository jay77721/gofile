# gofile Environment Configuration — Apache-2.0
# Copy to .env and adjust. All keys are read by internal/config/config.go (Load).
# Defaults shown match config.go; Docker Compose uses service names (mysql/minio/redis/typesense).

# ── Server ──────────────────────────────────────────────────────────
# Listen address. :8080 is used by docker-compose; local dev may use :8954 etc.
SERVER_ADDR=:8080
# Production: set true to mark cookies Secure (HTTPS only)
COOKIE_SECURE=false

# ── MySQL (required) ────────────────────────────────────────────────
# DSN must point to a reachable MySQL 8 instance. Migrations run on startup.
MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/gofile?charset=utf8mb4&parseTime=True&loc=Local

# ── Storage ─────────────────────────────────────────────────────────
# MinIO S3 (optional). Leave MINIO_ENDPOINT empty to use local disk fallback (UPLOAD_DIR).
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=filestore
MINIO_USE_SSL=false

# Local fallback directories (also used for temp chunks when MinIO disabled)
UPLOAD_DIR=./uploads
CHUNK_DIR=./chunks

# ── Redis (optional, graceful fallback) ─────────────────────────────
# Used for: dedup hash cache, distributed locks, rate limiting, Asynq queue
# If REDIS_ADDR empty, app degrades to no-cache / in-process chan.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── AI / Semantic Search (optional, AI_ENABLED=false by default) ───
AI_ENABLED=false
# mock | openai | anthropic  (mock = rule-based, no API key needed)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
# Must match Typesense collection dim; 128 for mock, 1536 for text-embedding-3-small
AI_EMBED_DIM=128
AI_WORKERS=4
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=xyz

# Per-user AI config (AES-GCM encrypted in DB, UI: /#ai-settings)
# If empty, derived from MYSQL_DSN so restarts can still decrypt.
AI_CONFIG_SECRET=
# Allow user-provided base_url to point at private nets (e.g. local Ollama). Default false = SSRF guard.
ALLOW_PRIVATE_AI_URL=false

# ── Asynq Distributed Queue (requires Redis) ────────────────────────
# true  → durable Redis queue (cross-instance, retry MaxRetry=3, DLQ, graceful fallback)
# false → in-process chan (capacity 100, lost on restart)
ASYNQ_ENABLED=false

# ── Observability (no env, code defaults) ───────────────────────────
# Prometheus /metrics, Grafana http://localhost:3000, healthz /healthz — see docker/deploy/

# ── Docker Compose overrides (only used in docker/docker-compose.yml) ─
# MYSQL_HOST=mysql, MINIO_INTERNAL_ENDPOINT=minio:9000, etc. are injected by Compose internal DNS.
# For Compose, copy .env.example to .env or rely on Compose defaults below (no .env required):
#   MYSQL_ROOT_PASSWORD / MYSQL_DATABASE / MINIO_ROOT_USER/PASSWORD / REDIS_PASSWORD
# See docker/docker-compose.yml for full list (DOCKER_SERVER_ADDR, TYPESENSE_*, …).
