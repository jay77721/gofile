# gofile Environment Configuration
# Copy this file to .env and adjust values as needed

# Server
SERVER_ADDR=:8080

# MySQL (required)
MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/gofile?charset=utf8mb4&parseTime=True&loc=Local

# MinIO (optional - leave MINIO_ENDPOINT empty to use local storage)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=filestore
MINIO_USE_SSL=false

# Local storage paths
UPLOAD_DIR=./uploads
CHUNK_DIR=./chunks

# Redis (optional)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# AI features (optional, disabled by default)
# Set AI_ENABLED=true to enable semantic search, file summarization, and auto-tagging
AI_ENABLED=false
AI_PROVIDER=mock
AI_API_KEY=
AI_EMBED_DIM=128
AI_WORKERS=4
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=xyz
